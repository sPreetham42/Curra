*.zip
*.tar.gz

# IDE and editor files
.idea/
.vscode/
*.swp
*~

# Local AI tooling (personal agent context — not project source)
.freebuff/
.claude/

# Graphify knowledge graph output (regenerated locally; never committed)
graphify-out/

# Local environment secret files
.env
.env.local
.env.*
!.env.example
